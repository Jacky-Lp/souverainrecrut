# Modèle du fichier .env. Le vrai .env est créé sur le serveur par le CI.
# Ne jamais mettre de vraies valeurs ici.

# Image du backend (Docker Hub)
DOCKERHUB_USER=votre_compte_dockerhub
IMAGE_NAME=souverainrecrut-backend
IMAGE_TAG=11

# PostgreSQL (éviter les caractères spéciaux dans le mot de passe : il est utilisé dans DATABASE_URL)
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=souverainrecrut

# Backend
JWT_SECRET=changez_moi_par_une_longue_valeur_aleatoire
FRONTEND_URL=http://localhost:5173
API_PORT=4000
